{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ContainerFlow",
    "Audience": "ContainerFlow",
    "SigningKey": "dev-only-signing-key-please-override-in-production"
  },
  "ReverseProxy": {
    "Routes": {
      "bookings": {
        "ClusterId": "booking-service",
        "Match": {
          "Path": "/api/bookings/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeader": "X-Correlation-Id", "Set": "{CorrelationId}" }
        ]
      },
      "containers": {
        "ClusterId": "container-service",
        "Match": {
          "Path": "/api/containers/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeader": "X-Correlation-Id", "Set": "{CorrelationId}" }
        ]
      },
      "notifications": {
        "ClusterId": "notification-service",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeader": "X-Correlation-Id", "Set": "{CorrelationId}" }
        ]
      }
    },
    "Clusters": {
      "booking-service": {
        "Destinations": {
          "booking-api": {
            "Address": "http://booking-api:8080/"
          }
        },
        "HttpRequest": {
          "ActivityContextHeaders": "None"
        }
      },
      "container-service": {
        "Destinations": {
          "container-api": {
            "Address": "http://container-api:8080/"
          }
        },
        "HttpRequest": {
          "ActivityContextHeaders": "None"
        }
      },
      "notification-service": {
        "Destinations": {
          "notification-api": {
            "Address": "http://notification-api:8080/"
          }
        },
        "HttpRequest": {
          "ActivityContextHeaders": "None"
        }
      }
    }
  }
}